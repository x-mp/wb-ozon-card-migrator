# Скопируйте файл в .env. Реальные значения никогда не добавляйте в Git.
WB_API_TOKEN=
MARKETPLACE_DATA_ROOT=/srv/marketplace-data
MARKETPLACE_SOURCE_ACCOUNT_ID=wb-main
MARKETPLACE_TARGET_ACCOUNT_ID=ozon-main
WB_API_AUTH_SCHEME=
WB_ACCOUNT_ID=main
WB_DATA_DIR=data
WB_HTTP_TIMEOUT_SECONDS=30
WB_HTTP_MAX_RETRIES=3
WB_MIN_REQUEST_INTERVAL_SECONDS=0.6
WB_MAX_REQUEST_BYTES=10485760
WB_USER_AGENT=wb-ozon-card-migrator/0.1

# Для собственного кабинета: Seller Client ID и Seller Api-Key.
OZON_CLIENT_ID=
OZON_API_KEY=
OZON_ACCOUNT_ID=main
OZON_OPENAPI_FILE=openapi/ozon/ozon-openapi-export-2026-07-30T11-06-35-360Z.json
OZON_HTTP_TIMEOUT_SECONDS=30
OZON_HTTP_MAX_RETRIES=3
OZON_USER_AGENT=wb-ozon-card-migrator/0.1

# Публичный HTTPS-префикс для преобразованных JPG-файлов.
OZON_MEDIA_BASE_URL=

# Не включайте постоянно. Установите только для одной утверждённой загрузки:
# OZON_ENABLE_WRITES=UPLOAD_APPROVED_PLANS
